---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { services } from '../lib/services';

const description = 'AI Product Development、Business Automation、Web/SaaS Development、Cloud/Debuggingの4領域で開発を支援します。';
---

<BaseLayout title="Services" description={description}>
  <section class="mx-auto max-w-3xl px-6 py-20">
    <h1 class="text-2xl font-semibold">Services</h1>
    <p class="mt-4 max-w-xl text-sm leading-relaxed text-[var(--color-fg-muted)]">{description}</p>

    <div class="mt-12 space-y-8">
      {
        services.map((service) => (
          <div class="rounded-lg border border-[var(--color-border)] p-8">
            <h2 class="text-lg font-semibold">{service.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-[var(--color-fg-muted)]">{service.description}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-12 text-center">
      <Button href="/contact">開発を相談する</Button>
    </div>
  </section>
</BaseLayout>
