---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import { getPublished } from '../lib/content';
import { buildWebsiteJsonLd } from '../lib/seo';

const description =
  '社内資料を根拠付きで検索・回答するRAGシステムを、PoCから検索品質の評価・改善、本番導入まで支援します。';
const services = (await getPublished('services')).sort((a, b) => a.data.order - b.data.order);
const solutions = (await getPublished('solutions')).sort((a, b) => a.data.order - b.data.order).slice(0, 6);
const proofs = (await getPublished('openSource')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="TechVit"
  description={description}
  alternates={[
    { lang: 'ja', href: '/' },
    { lang: 'en', href: '/en/' },
    { lang: 'x-default', href: '/' },
  ]}
  jsonLd={buildWebsiteJsonLd({ description })}
>
  <Hero eyebrow="RAG・AI検索システム開発" title="社内資料を、根拠付きで回答できるAIへ。" lead={description}>
    <Button href="/services/rag-knowledge-search">RAG開発サービスを見る</Button>
    <Button href="/contact?topic=internal-search" variant="secondary">導入について相談する</Button>
  </Hero>

  <section class="border-y border-[var(--color-border)] bg-[var(--color-bg-subtle)]">
    <div class="mx-auto grid max-w-4xl gap-8 px-6 py-14 md:grid-cols-[1.05fr_.95fr] md:items-center">
      <div>
        <p class="font-mono text-xs text-[var(--color-accent)]">FEATURED SERVICE</p>
        <h2 class="mt-3 text-2xl font-semibold">RAG・社内ナレッジ検索開発</h2>
        <p class="mt-4 text-sm leading-relaxed text-[var(--color-fg-muted)]">
          PDF、FAQ、マニュアル、議事録などを横断検索し、回答と一緒に引用元を表示。作って終わりではなく、Golden
          Datasetで検索・回答品質を測り、改善します。
        </p>
        <a
          href="/services/rag-knowledge-search"
          class="mt-6 inline-flex text-sm font-medium text-[var(--color-accent)]"
        >
          仕組み・デモ・導入方法を見る →
        </a>
      </div>
      <figure class="overflow-hidden rounded-xl border border-[var(--color-border)] bg-white shadow-sm">
        <img
          src="/images/services/rag/knowledge-search-flow.webp"
          alt="複数の社内文書から関連情報を検索し、回答と引用元を提示するRAGシステムの概念図"
          width="1536"
          height="1024"
          loading="eager"
          decoding="async"
          class="aspect-[3/2] h-auto w-full object-cover"
        />
        <figcaption
          class="border-t border-[var(--color-border)] px-4 py-3 text-xs text-[var(--color-fg-muted)]"
        >
          社内資料 → 検索 → 根拠付き回答の流れ（概念図）
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-16">
    <p class="font-mono text-xs text-[var(--color-accent)]">CUSTOMER PROBLEMS</p>
    <h2 class="mt-3 text-2xl font-semibold">こんな課題を解決します</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      <Card
        href="/solutions/excel-automation"
        title="反復作業が減らない"
        description="Excel、文書、メールの転記・確認・下書きを整理します。"
      />
      <Card
        href="/solutions/rag-accuracy"
        title="AIの精度を説明できない"
        description="RAGの検索と生成を分け、正解データで改善します。"
      />
      <Card
        href="/solutions/performance-regression"
        title="改善効果を測れない"
        description="性能や品質の変更前後を、再現可能なEvidenceで比較します。"
      />
    </div>
  </section>

  <section class="border-y border-[var(--color-border)] bg-[var(--color-bg-subtle)]">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <div class="flex items-end justify-between">
        <div>
          <p class="font-mono text-xs text-[var(--color-accent)]">SERVICES</p><h2
            class="mt-3 text-2xl font-semibold"
          >
            依頼できること
          </h2>
        </div><a href="/services" class="text-sm text-[var(--color-accent)]">すべて見る →</a>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          services
            .slice(0, 6)
            .map((entry) => (
              <Card
                href={`/services/${entry.id}`}
                title={entry.data.title}
                description={entry.data.summary}
              />
            ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-16">
    <div class="flex items-end justify-between">
      <div>
        <p class="font-mono text-xs text-[var(--color-accent)]">SOLUTIONS</p><h2
          class="mt-3 text-2xl font-semibold"
        >
          課題から探す
        </h2>
      </div><a href="/solutions" class="text-sm text-[var(--color-accent)]">すべて見る →</a>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        solutions.map((entry) => (
          <Card href={`/solutions/${entry.id}`} title={entry.data.title} description={entry.data.summary} />
        ))
      }
    </div>
  </section>

  <section class="border-y border-[var(--color-border)] bg-[var(--color-bg-subtle)]">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <p class="font-mono text-xs text-[var(--color-accent)]">HOW TECHVIT WORKS</p><h2
        class="mt-3 text-2xl font-semibold"
      >
        小さく測り、実装し、改善する
      </h2>
      <ol class="mt-8 grid gap-6 sm:grid-cols-3">
        <li>
          <span class="font-mono text-sm text-[var(--color-accent)]">01</span><h3 class="mt-2 font-semibold">
            課題と基準を決める
          </h3><p class="mt-2 text-sm text-[var(--color-fg-muted)]">現行作業、制約、成功条件を整理します。</p>
        </li>
        <li>
          <span class="font-mono text-sm text-[var(--color-accent)]">02</span><h3 class="mt-2 font-semibold">
            小さく実装する
          </h3><p class="mt-2 text-sm text-[var(--color-fg-muted)]">一工程を動かし、実データで確認します。</p>
        </li>
        <li>
          <span class="font-mono text-sm text-[var(--color-accent)]">03</span><h3 class="mt-2 font-semibold">
            Evidenceで改善する
          </h3><p class="mt-2 text-sm text-[var(--color-fg-muted)]">
            変更前後を比較し、次の判断につなげます。
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-16">
    <div class="flex items-end justify-between">
      <div>
        <p class="font-mono text-xs text-[var(--color-accent)]">TECHNICAL PROOF</p><h2
          class="mt-3 text-2xl font-semibold"
        >
          Open Source
        </h2>
      </div><a href="/open-source" class="text-sm text-[var(--color-accent)]">すべて見る →</a>
    </div>
    <p class="mt-4 max-w-2xl text-sm text-[var(--color-fg-muted)]">
      OSSは営業自動化のためではなく、測定・検出・検証を実装できることのProof of Workとして公開しています。
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        proofs.map((entry) => (
          <Card
            href={`/open-source/${entry.id}`}
            title={entry.data.title}
            description={entry.data.summary}
            eyebrow={entry.data.status === 'available' ? 'Available' : 'In Development'}
          />
        ))
      }
    </div>
  </section>

  <section class="border-y border-[var(--color-border)] bg-[var(--color-bg-subtle)]">
    <div class="mx-auto grid max-w-4xl gap-8 px-6 py-16 sm:grid-cols-2">
      <div>
        <p class="font-mono text-xs text-[var(--color-accent)]">CASES / VALIDATION</p><h2
          class="mt-3 text-2xl font-semibold"
        >
          実績は、根拠と一緒に。
        </h2><p class="mt-3 text-sm leading-relaxed text-[var(--color-fg-muted)]">
          架空の顧客事例や効果数値は掲載しません。現在は公開実装と検証可能なProjectsを提示しています。
        </p><a href="/cases" class="mt-4 inline-block text-sm text-[var(--color-accent)]"
          >事例・検証の方針を見る →</a
        >
      </div><div>
        <p class="font-mono text-xs text-[var(--color-accent)]">ABOUT</p><h2
          class="mt-3 text-2xl font-semibold"
        >
          相談から実装・検証まで。
        </h2><p class="mt-3 text-sm leading-relaxed text-[var(--color-fg-muted)]">
          TechVitは、業務上の問いを技術要件へ落とし、Web・AI・クラウドを組み合わせて動くところまで担当します。
        </p><a href="/about" class="mt-4 inline-block text-sm text-[var(--color-accent)]">TechVitについて →</a
        >
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-20 text-center">
    <h2 class="text-2xl font-semibold">まだ要件が固まっていなくても構いません。</h2><p
      class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-[var(--color-fg-muted)]"
    >
      困っている作業、使っている資料、改善したい指標から一緒に整理します。
    </p><div class="mt-8"><Button href="/contact">相談する</Button></div>
  </section>
</BaseLayout>
