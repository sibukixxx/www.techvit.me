---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
const description = '公開可能な実績、検証結果、Benchmarkを、条件と根拠が確認できる形で掲載します。';
---

<BaseLayout title="事例・検証" description={description} alternates={[]}
  ><section class="mx-auto max-w-3xl px-6 py-20">
    <p class="font-mono text-xs text-[var(--color-accent)]">CASES / VALIDATION</p><h1
      class="mt-3 text-3xl font-semibold"
    >
      事例・検証
    </h1><p class="mt-4 text-sm leading-relaxed text-[var(--color-fg-muted)]">{description}</p><div
      class="mt-10 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-6"
    >
      <h2 class="font-semibold">架空の導入実績は掲載しません</h2><p
        class="mt-2 text-sm leading-relaxed text-[var(--color-fg-muted)]"
      >
        現在は、実装コードとテストを確認できるOpen
        Source、および既存のProjectsを技術的なProofとして案内しています。顧客名・効果数値を公開できる実績が整い次第、前提条件と測定方法を添えて追加します。
      </p>
    </div><div class="mt-8 grid gap-4 sm:grid-cols-2">
      <Card
        href="/open-source"
        title="Open Source"
        description="測定・検出・検証の実装とテストを見る"
        eyebrow="Proof of Work"
      /><Card
        href="/projects"
        title="Projects"
        description="開発・運営しているプロダクトを見る"
        eyebrow="Existing work"
      />
    </div>
  </section></BaseLayout
>
