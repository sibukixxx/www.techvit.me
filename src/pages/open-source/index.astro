---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getPublished } from '../../lib/content';
const description =
  'TechVitが公開している、測定・検出・検証のためのOSS。実装コードとテストを、技術力のProof of Workとして公開しています。';
const entries = (await getPublished('openSource')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Open Source" description={description} alternates={[]}
  ><section class="mx-auto max-w-4xl px-6 py-20">
    <p class="font-mono text-xs text-[var(--color-accent)]">TECHNICAL PROOF</p><h1
      class="mt-3 text-3xl font-semibold"
    >
      Open Source
    </h1><p class="mt-4 max-w-2xl text-sm leading-relaxed text-[var(--color-fg-muted)]">{description}</p><div
      class="mt-12 grid gap-4 sm:grid-cols-2"
    >
      {
        entries.map((entry) => (
          <Card
            href={`/open-source/${entry.id}`}
            title={entry.data.title}
            description={entry.data.summary}
            eyebrow={entry.data.status === 'available' ? 'Available' : 'In Development'}
          />
        ))
      }
    </div>
  </section></BaseLayout
>
