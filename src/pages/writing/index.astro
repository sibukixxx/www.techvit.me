---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getPublished, writingCategoryLabels } from '../../lib/content';

const description = 'Engineering、AI & Business、Experimentsの3カテゴリで書いています。';
const posts = (await getPublished('writing')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const dateFormatter = new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout title="Writing" description={description}>
  <section class="mx-auto max-w-4xl px-6 py-20">
    <h1 class="text-2xl font-semibold">Writing</h1>
    <p class="mt-4 max-w-xl text-sm leading-relaxed text-[var(--color-fg-muted)]">{description}</p>

    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      {
        posts.map((post) => (
          <Card
            href={`/writing/${post.id}`}
            title={post.data.title}
            description={post.data.description}
            eyebrow={writingCategoryLabels[post.data.category]}
            meta={dateFormatter.format(post.data.pubDate)}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
