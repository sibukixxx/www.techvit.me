---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page Not Found" description="お探しのページが見つかりませんでした。" noindex>
  <section class="mx-auto max-w-xl px-6 py-32 text-center">
    <p class="font-mono text-sm text-[var(--color-fg-muted)]">404</p>
    <h1 class="mt-4 text-2xl font-semibold">Page Not Found</h1>
    <p class="mt-3 text-sm leading-relaxed text-[var(--color-fg-muted)]">
      お探しのページが見つかりませんでした。URLが正しいかご確認ください。
    </p>
    <div class="mt-8">
      <Button href="/">トップへ戻る</Button>
    </div>
  </section>
</BaseLayout>
