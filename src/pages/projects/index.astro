---
import ContentListPage from '../../components/ContentListPage.astro';
import { getPublished, projectStatusLabels } from '../../lib/content';

const description = '実際に設計・開発、あるいは自分自身で運営しているプロダクト。';
const projects = (await getPublished('projects')).sort((a, b) => a.data.order - b.data.order);
---

<ContentListPage
  title="Projects"
  description={description}
  items={projects.map((project) => ({
    href: `/projects/${project.id}`,
    title: project.data.title,
    description: project.data.description,
    eyebrow: projectStatusLabels[project.data.status],
  }))}
/>
