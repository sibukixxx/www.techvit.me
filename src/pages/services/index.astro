---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getPublished } from '../../lib/content';

const description = 'AI Development、Business Automation、Web/SaaS Development、Cloudflare/AWS、LLM Evaluation、Technical Consultingの領域で開発を支援します。';
const services = (await getPublished('services')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Services" description={description}>
  <section class="mx-auto max-w-3xl px-6 py-20">
    <h1 class="text-2xl font-semibold">Services</h1>
    <p class="mt-4 max-w-xl text-sm leading-relaxed text-[var(--color-fg-muted)]">{description}</p>

    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      {
        services.map((service) => (
          <Card href={`/services/${service.id}`} title={service.data.title} description={service.data.summary} />
        ))
      }
    </div>
  </section>
</BaseLayout>
