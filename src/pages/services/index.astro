---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import Button from '../../components/Button.astro';
import { getPublished } from '../../lib/content';

const description =
  'TechVitへ依頼できるAI・業務自動化、RAG・社内検索、Web・業務システム開発と、専門的な診断・改善支援をご案内します。';
const mainServiceIds = ['automation-development', 'rag-knowledge-search', 'web-saas-development'];
const services = (await getPublished('services')).sort((a, b) => a.data.order - b.data.order);
const specialistServices = services.filter((service) => !mainServiceIds.includes(service.id));
const pillars = [
  {
    title: 'AI・業務自動化',
    description: 'Excel、文書、メール、営業調査などの反復作業を、確認可能な業務フローとして自動化します。',
    href: '/services/automation-development',
    image: '/images/services/automation/workflow-automation.webp',
    alt: '表計算、PDF、メールなどを処理して成果物へ変換する業務自動化の概念図',
    meta: '転記・集計 / 文書処理 / メール / API連携',
  },
  {
    title: 'RAG・社内検索',
    description: '社内資料を横断検索し、根拠を示して回答するAI検索を構築し、検索・回答品質を改善します。',
    href: '/services/rag-knowledge-search',
    image: '/images/services/rag/knowledge-search-flow.webp',
    alt: '社内文書から関連情報を検索し、回答と引用元を提示するRAGの概念図',
    meta: '資料検索 / 根拠付き回答 / RAG評価・改善',
  },
  {
    title: 'Web・業務システム',
    description: '管理画面、API、データベース、クラウドまで、業務で使い続けられるシステムを開発します。',
    href: '/services/web-saas-development',
    image: '/images/services/web/end-to-end-system.webp',
    alt: 'Web画面、API、データベース、クラウドを一体で構築する概念図',
    meta: 'Web UI / API / DB / クラウド運用',
  },
];
---

<BaseLayout title="サービス" description={description}>
  <section class="mx-auto max-w-5xl px-6 py-20">
    <p class="font-mono text-xs text-[var(--color-accent)]">SERVICES</p>
    <h1 class="mt-3 text-3xl font-semibold">依頼したいことから選ぶ</h1>
    <p class="mt-5 max-w-2xl text-sm leading-7 text-[var(--color-fg-muted)]">{description}</p>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {
        pillars.map((pillar) => (
          <a
            href={pillar.href}
            class="group overflow-hidden rounded-2xl border border-[var(--color-border)] transition hover:border-blue-200 hover:shadow-lg hover:shadow-blue-950/5"
          >
            <img
              src={pillar.image}
              alt={pillar.alt}
              width="1536"
              height="1024"
              loading="eager"
              decoding="async"
              class="aspect-[3/2] w-full object-cover"
            />
            <div class="p-6">
              <h2 class="text-xl font-semibold group-hover:text-[var(--color-accent)]">{pillar.title}</h2>
              <p class="mt-3 text-sm leading-7 text-[var(--color-fg-muted)]">{pillar.description}</p>
              <p class="mt-5 border-t border-[var(--color-border)] pt-4 text-xs leading-6 text-[var(--color-fg-muted)]">
                {pillar.meta}
              </p>
              <p class="mt-4 text-sm font-medium text-[var(--color-accent)]">詳しく見る →</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="border-y border-[var(--color-border)] bg-[var(--color-bg-subtle)]">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="font-mono text-xs text-[var(--color-accent)]">SPECIALIST SUPPORT</p>
      <h2 class="mt-3 text-2xl font-semibold">対象を絞った診断・改善支援</h2>
      <p class="mt-4 max-w-2xl text-sm leading-7 text-[var(--color-fg-muted)]">
        主力サービスの中から、特定の課題や工程だけを切り出して依頼することもできます。
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          specialistServices.map((service) => (
            <Card
              href={`/services/${service.id}`}
              title={service.data.title}
              description={service.data.summary}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-20 text-center">
    <h2 class="text-2xl font-semibold">どのサービスか決める前から相談できます。</h2>
    <p class="mx-auto mt-4 max-w-xl text-sm leading-7 text-[var(--color-fg-muted)]">
      現在の作業、資料、既存システムを確認し、最初に取り組む範囲を整理します。
    </p>
    <div class="mt-8"><Button href="/contact">開発内容を相談する</Button></div>
  </section>
</BaseLayout>
