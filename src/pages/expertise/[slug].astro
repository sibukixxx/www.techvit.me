---
import { getPublished } from '../../lib/content';
import { render } from 'astro:content';
import ExpertiseLayout from '../../layouts/ExpertiseLayout.astro';

export async function getStaticPaths() {
  const expertise = await getPublished('expertise');
  return expertise.map((entry) => ({
    params: { slug: entry.id },
    props: { expertise: entry },
  }));
}

const { expertise } = Astro.props;
const { Content } = await render(expertise);
---

<ExpertiseLayout expertise={expertise}>
  <Content />
</ExpertiseLayout>
