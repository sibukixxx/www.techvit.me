---
import ContentListPage from '../../components/ContentListPage.astro';
import { getPublished, labStatusLabels } from '../../lib/content';

const description =
  'Experiments in AI-native software businesses. 自分で作り、検証しているプロダクト・事業の記録。';
const items = (await getPublished('lab')).sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
);
---

<ContentListPage
  title="Lab"
  description={description}
  items={items.map((item) => ({
    href: `/lab/${item.id}`,
    title: item.data.title,
    description: item.data.description,
    eyebrow: labStatusLabels[item.data.status],
  }))}
/>
