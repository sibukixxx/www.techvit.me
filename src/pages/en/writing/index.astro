---
import ContentListPage from '../../../components/ContentListPage.astro';
import { getPublished, writingCategoryLabels } from '../../../lib/content';

const description =
  'Notes on engineering, AI and business, and experiments in building independent software products.';
const posts = (await getPublished('writingEn')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const dateFormatter = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<ContentListPage
  title="Writing"
  description={description}
  lang="en"
  searchable
  items={posts.map((post) => ({
    href: `/en/writing/${post.id}`,
    title: post.data.title,
    description: post.data.description,
    eyebrow: writingCategoryLabels[post.data.category],
    meta: dateFormatter.format(post.data.pubDate),
    keywords: post.data.tags.join(' '),
  }))}
/>
