---
import { getEntryStaticPaths } from '../../../lib/content';
import { render } from 'astro:content';
import WritingLayout from '../../../layouts/WritingLayout.astro';

export const getStaticPaths = () => getEntryStaticPaths('writingEn');

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<WritingLayout post={entry} lang="en"><Content /></WritingLayout>
