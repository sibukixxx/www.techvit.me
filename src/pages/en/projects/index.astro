---
import ContentListPage from '../../../components/ContentListPage.astro';
import { getPublished, projectStatusLabels } from '../../../lib/content';

const description = 'Products I have designed, developed, or currently operate.';
const projects = (await getPublished('projectsEn')).sort((a, b) => a.data.order - b.data.order);
---

<ContentListPage
  title="Projects"
  description={description}
  lang="en"
  items={projects.map((project) => ({
    href: `/en/projects/${project.id}`,
    title: project.data.title,
    description: project.data.description,
    eyebrow: projectStatusLabels[project.data.status],
  }))}
/>
