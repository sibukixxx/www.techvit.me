---
import { getEntryStaticPaths } from '../../../lib/content';
import { render } from 'astro:content';
import LabLayout from '../../../layouts/LabLayout.astro';

export const getStaticPaths = () => getEntryStaticPaths('labEn');

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<LabLayout item={entry} lang="en"><Content /></LabLayout>
