---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import { services } from '../../lib/services';

const description = 'Development support across AI products, business automation, web and SaaS applications, cloud infrastructure, and debugging.';
---

<BaseLayout title="Services" description={description} lang="en">
  <section class="mx-auto max-w-3xl px-6 py-20">
    <h1 class="text-2xl font-semibold">Services</h1>
    <p class="mt-4 max-w-xl text-sm leading-relaxed text-[var(--color-fg-muted)]">{description}</p>
    <div class="mt-12 space-y-8">
      {services.map((service) => (
        <div class="rounded-lg border border-[var(--color-border)] p-8">
          <h2 class="text-lg font-semibold">{service.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-[var(--color-fg-muted)]">{service.descriptionEn}</p>
        </div>
      ))}
    </div>
    <div class="mt-12 text-center"><Button href="/en/contact">Discuss a project</Button></div>
  </section>
</BaseLayout>
