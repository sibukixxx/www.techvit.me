---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import { getPublished } from '../../lib/content';

const description = 'Development support across AI development, business automation, web and SaaS applications, Cloudflare/AWS infrastructure, LLM evaluation, and technical consulting.';
const services = (await getPublished('services')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Services" description={description} lang="en">
  <section class="mx-auto max-w-3xl px-6 py-20">
    <h1 class="text-2xl font-semibold">Services</h1>
    <p class="mt-4 max-w-xl text-sm leading-relaxed text-[var(--color-fg-muted)]">{description}</p>
    <div class="mt-12 space-y-8">
      {services.map((service) => (
        <div class="rounded-lg border border-[var(--color-border)] p-8">
          <h2 class="text-lg font-semibold">{service.data.titleEn ?? service.data.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-[var(--color-fg-muted)]">{service.data.descriptionEn ?? service.data.summary}</p>
        </div>
      ))}
    </div>
    <div class="mt-12 text-center"><Button href="/en/contact">Discuss a project</Button></div>
  </section>
</BaseLayout>
