---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Button from '../../components/Button.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Card from '../../components/Card.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getPublished } from '../../lib/content';
import { products } from '../../lib/products';
import { services } from '../../lib/services';
import { buildWebsiteJsonLd } from '../../lib/seo';

const description =
  'I design and build AI-powered business systems, web services, and automation tools—from requirements and implementation to debugging and cloud operations.';

const allProjects = await getPublished('projectsEn');
const featuredProjects = allProjects
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout
  title="techvit — English"
  description={description}
  lang="en"
  alternates={[
    { lang: 'ja', href: '/' },
    { lang: 'en', href: '/en/' },
    { lang: 'x-default', href: '/' },
  ]}
  jsonLd={buildWebsiteJsonLd({ description })}
>
  <Hero
    eyebrow="Independent Software Engineer & Product Builder"
    title="Small, fast software development for the AI era."
    lead={description}
  >
    <Button href="/en/contact">Discuss a project</Button>
    <Button href="/en/projects" variant="secondary">View projects</Button>
  </Hero>

  <section class="mx-auto max-w-3xl px-6 py-4">
    <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-8">
      <p class="text-sm leading-loose">
        I am a freelance software engineer with experience in web development, cloud infrastructure, and business systems.
        Today, I integrate AI into the development process to help small teams launch useful products in less time. My work
        is not simply about having AI write code—it is about deciding what to build, verifying that it works, and making
        sure it delivers value in real-world use.
      </p>
    </div>
  </section>

  <section id="products" class="mx-auto max-w-4xl scroll-mt-8 px-6 py-20">
    <div class="mb-8">
      <h2 class="text-xl font-semibold">Products / Tools</h2>
      <p class="mt-2 text-sm text-[var(--color-fg-muted)]">Services, tools, and media products I build and operate.</p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        products.map((product) => (
          <ProductCard
            title={product.title}
            description={product.descriptionEn}
            category={product.category}
            url={product.url}
            icon={product.icon}
          />
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-20">
    <div class="mb-8 flex items-end justify-between">
      <h2 class="text-xl font-semibold">Services</h2>
      <a href="/en/services" class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)]">View all →</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {services.map((service) => <ServiceCard title={service.title} description={service.summaryEn} />)}
    </div>
  </section>

  {
    featuredProjects.length > 0 && (
      <section class="mx-auto max-w-4xl px-6 py-20">
        <div class="mb-8 flex items-end justify-between">
          <h2 class="text-xl font-semibold">Selected Projects</h2>
          <a href="/en/projects" class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)]">
            View all →
          </a>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {featuredProjects.map((project) => (
            <Card
              href={`/en/projects/${project.id}`}
              title={project.data.title}
              description={project.data.description}
              eyebrow={project.data.status}
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-3xl px-6 py-20 text-center">
    <h2 class="text-xl font-semibold">Let’s discuss your project</h2>
    <p class="mx-auto mt-3 max-w-md text-sm text-[var(--color-fg-muted)]">
      You are welcome to reach out about business systems, web services, or automation—even if the requirements are still taking shape.
    </p>
    <div class="mt-6">
      <Button href="/en/contact">Contact me</Button>
    </div>
  </section>
</BaseLayout>
