<script>
  // Fire grave_care_plan_view once when the pricing section becomes visible.
  const planSection = document.querySelector<HTMLElement>('#plan');
  if (planSection && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      const analyticsWindow = window as typeof window & {
        gtag?: (...args: unknown[]) => void;
        dataLayer?: unknown[];
      };
      const params = { source_path: window.location.pathname };
      if (typeof analyticsWindow.gtag === 'function')
        analyticsWindow.gtag('event', 'grave_care_plan_view', params);
      else analyticsWindow.dataLayer?.push({ event: 'grave_care_plan_view', ...params });
    });
    observer.observe(planSection);
  }
</script>
