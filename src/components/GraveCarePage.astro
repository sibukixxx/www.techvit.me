---
import BaseLayout from '../layouts/BaseLayout.astro';
import GraveCareFigure from './GraveCareFigure.astro';
import GraveCareInquiryForm from './GraveCareInquiryForm.astro';
import { graveCareImages } from '../lib/grave-care-images';
import {
  graveCarePayment,
  graveCarePlans,
  graveCareSchedule,
  graveCareServiceArea,
  formatGraveCarePrice,
} from '../lib/grave-care';
import { absoluteUrl, buildBreadcrumbJsonLd, buildFaqJsonLd } from '../lib/seo';

interface Props {
  lang?: 'ja' | 'en';
}
const { lang = 'ja' } = Astro.props;
const en = lang === 'en';
const path = en ? '/en/grave-care/' : '/grave-care/';
const ogImage = '/og/grave-care.jpg';
const title = en ? 'Annual Grave Care in Tokyo and Tama' : '東京・多摩の年間お墓見守り';
const description = en
  ? 'Two or four grave-care visits a year centered on Nishitokyo and the Tama area, with condition checks, light cleaning and photo reports. Paid annually by card.'
  : '西東京市・多摩地域を中心に、年2回または年4回の状態確認・簡易清掃・写真報告を行う年間お墓見守りサービス。飯能方面もご相談ください。';
const ctaLabel = en ? 'Ask about availability' : '対応可能か相談する';
const planCtaLabel = en ? 'Ask about this plan' : 'このプランについて相談する';
const imageNotice = en ? 'Illustrative service image' : '※画像はサービスイメージです';
const lowestPrice = Math.min(...graveCarePlans.map((plan) => plan.price));
const heroFacts = en
  ? [
      '4 or 2 visits a year',
      `From ${formatGraveCarePrice(lowestPrice, lang)} / year`,
      'Photo report every visit',
    ]
  : [
      '年4回 または 年2回の訪問',
      `${formatGraveCarePrice(lowestPrice, lang)}〜（税込）/ 年`,
      '毎回写真でご報告',
    ];
const problems = en
  ? [
      'You live far from the family grave.',
      'Age makes cemetery visits difficult.',
      'Work or childcare keeps you away at seasonal times.',
      'You want to check the condition regularly.',
    ]
  : [
      '実家のお墓から遠くに住んでいる',
      '高齢になり墓参りが負担になってきた',
      '仕事や育児で彼岸・お盆に行けない',
      '墓所の状態だけでも定期的に確認したい',
    ];
const servicePoints = en
  ? [
      { label: 'Condition check', detail: 'We look for damage, tilting and soiling around the plot.' },
      { label: 'Light cleaning', detail: 'Wiping the stone and sweeping the surrounding area.' },
      { label: 'Light weeding', detail: 'Removing weeds inside the plot.' },
      { label: 'Before and after photos', detail: 'Each visit is recorded before and after the work.' },
    ]
  : [
      { label: '墓所の状態確認', detail: '傷み・傾き・汚れの有無を確認します。' },
      { label: '簡易清掃', detail: '墓石の拭き上げと、周辺の掃き掃除。' },
      { label: '軽度の除草', detail: '区画内の草取りを行います。' },
      { label: 'Before・After撮影', detail: '作業前後を毎回写真に残します。' },
    ];
const reportPoints = en
  ? [
      'Photos of the condition on arrival and after the work',
      'A completion report after every visit',
      'Check from anywhere, without travelling',
    ]
  : [
      '訪問時のお墓の状態と、作業後の様子',
      '毎回の訪問ごとに作業完了報告',
      '遠くにお住まいでも、移動せずに確認',
    ];
const flowSteps = en
  ? [
      { title: 'Inquiry', detail: 'Tell us the cemetery, the plot and your preferred plan.' },
      { title: 'Availability check', detail: 'We confirm the location, cemetery rules and scope of work.' },
      { title: 'Payment', detail: 'If we can help, we send you a link to Square’s secure checkout page.' },
      { title: 'Annual care begins', detail: 'Once payment is confirmed, we share the visit schedule.' },
    ]
  : [
      { title: 'お問い合わせ', detail: '墓地・墓所・希望プランをお知らせください。' },
      { title: '対応可否を確認', detail: '所在地、霊園の規則、作業内容を確認します。' },
      { title: 'お支払い', detail: '対応可能な場合、Squareの安全な決済ページをご案内します。' },
      { title: '年間見守り開始', detail: '決済確認後、訪問スケジュールをご案内します。' },
    ];
const included = en
  ? [
      'Condition check',
      'Light cleaning',
      'Light weeding',
      'Moment of respect',
      'Before and after photos',
      'Photo report',
    ]
  : ['墓所の状態確認', '簡易清掃', '軽度の除草', '合掌', 'Before・After写真', '写真報告'];
const excluded = en
  ? [
      'Stone repair or polishing',
      'Special chemical cleaning',
      'Stonework or relocation',
      'Major pruning or extensive weeding',
      'Paid passenger transport',
    ]
  : [
      '墓石の修理・研磨',
      '強力な薬剤を使う特殊洗浄',
      '石材工事・墓石や付属物の移設',
      '大規模な剪定・大量の除草',
      'お客様の有償送迎',
    ];
const paymentPoints = en
  ? [
      `Payment method: ${graveCarePayment.methodEn.toLowerCase()} (Visa, Mastercard and other cards accepted by ${graveCarePayment.provider}).`,
      `After we confirm availability, we send you a link to ${graveCarePayment.provider}’s secure checkout page.`,
      'Your card details are never stored on this site; payment is processed on Square’s page.',
      'No automatic renewal. We contact you before the contract ends.',
      'Flowers and incense are charged separately.',
    ]
  : [
      `支払方法：${graveCarePayment.method}（${graveCarePayment.provider}決済）`,
      `対応可否を確認後、${graveCarePayment.provider}の安全な決済ページをご案内します。`,
      'カード情報は当サイトでは保持しません。決済はSquareの決済ページで行われます。',
      '自動更新はありません。契約終了前にご案内します。',
      '供花・線香は別途承ります。',
    ];
const faqs = en
  ? [
      {
        question: 'Which areas do you cover?',
        answer: `${graveCareServiceArea.publicMessageEn} We confirm availability after checking the cemetery location and regulations.`,
      },
      {
        question: 'When are the visits?',
        answer:
          'The four-visit plan covers March, July–August, September and December. With the two-visit plan you choose two of these periods. Work is completed sequentially within each period.',
      },
      {
        question: 'Can I specify an exact date?',
        answer:
          'You may tell us your preference, but exact dates are not normally guaranteed. Requests at the same cemetery are grouped where practical.',
      },
      {
        question: 'How do I pay?',
        answer:
          'By credit card, as a single annual payment on Square’s secure checkout page. We send the link only after confirming that we can serve your grave. There is no automatic renewal; bank transfer is not offered as a standard option.',
      },
      {
        question: 'Are flowers and incense included?',
        answer:
          'They are not included in the annual price. Flowers are charged at cost plus an arrangement fee where needed; incense is optional. Fixed flower pricing will follow supplier-cost confirmation.',
      },
      {
        question: 'What happens in bad weather?',
        answer:
          'A visit may be postponed due to severe weather, disaster, traffic, cemetery circumstances or any condition that makes work unsafe.',
      },
      {
        question: 'Can you repair gravestones?',
        answer:
          'No. Repair, polishing and stonework are outside this plan and require consultation with a specialist.',
      },
      {
        question: 'How will I receive photos?',
        answer:
          'We plan to deliver them digitally. The exact delivery method and retention period are to be finalized.',
      },
      {
        question: 'What if cemetery rules prohibit the work?',
        answer:
          'Cemetery rules take priority. We may change the scope or decline the request after confirmation.',
      },
      {
        question: 'What is the cancellation or refund policy?',
        answer:
          'Before work begins, the contract may be cancelled. After the first visit, completed work and incurred costs are deducted. Purchased flowers and similar items are non-refundable. The detailed refund calculation will be finalized before the terms are published.',
      },
      {
        question: 'How do I identify the plot?',
        answer:
          'Please provide only the cemetery name, location and minimum plot information needed. We may ask for a map or photo after the initial inquiry.',
      },
    ]
  : [
      {
        question: 'どの地域に対応していますか？',
        answer: `${graveCareServiceArea.publicMessage} 墓地・霊園の所在地と管理規則を確認してから、個別に対応可否をご案内します。`,
      },
      {
        question: '訪問はいつですか？',
        answer:
          '年4回プランは春彼岸の3月、お盆の7〜8月、秋彼岸の9月、年末の12月に巡回します。年2回プランはこの4つの時期から希望の2回をお選びいただけます。ピンポイントの日付指定ではなく、各巡回期間内に順次作業します。',
      },
      {
        question: '日付指定はできますか？',
        answer:
          '希望日は伺いますが、原則として各巡回期間内に順次作業します。同一霊園のご依頼は、可能な限り同日にまとめます。',
      },
      {
        question: 'お支払い方法は？',
        answer:
          'クレジットカードによる年間一括前払いです。対応可能と確認できた場合に、Squareの安全な決済ページのリンクをご案内します。カード情報は当サイトでは保持しません。自動更新はなく、銀行振込は標準の支払方法としてはご用意していません。',
      },
      {
        question: '供花・線香は含まれますか？',
        answer:
          '年間料金には含まれません。供花は実費に加え、必要な場合は手配費をいただきます。線香はオプションです。固定料金は仕入れ先と原価の確認後に決定します。',
      },
      {
        question: '雨天時はどうなりますか？',
        answer:
          '悪天候、災害、交通事情、霊園事情などにより延期する場合があります。安全に作業できない場合も同様です。',
      },
      {
        question: '墓石の修理はできますか？',
        answer: '修理、研磨、石材工事は本プランの対象外です。必要に応じて専門業者への相談をご案内します。',
      },
      {
        question: '写真はどのように届きますか？',
        answer: 'デジタルでの送付を予定しています。送付方法と保存期間は正式決定後、ご契約前にご案内します。',
      },
      {
        question: '墓地・霊園の規則で作業できない場合は？',
        answer:
          '墓地・霊園の管理規則を優先します。確認結果により作業内容の変更、またはご依頼をお断りする場合があります。',
      },
      {
        question: 'キャンセル・返金条件は？',
        answer:
          '作業着手前はキャンセルできます。初回作業後の途中解約では、実施済み作業分と発生済み実費を控除して精算します。購入済みの供花などの実費は返金対象外です。詳細な返金計算方法は利用規約公開前に確定します。',
      },
      {
        question: '墓所位置はどう伝えますか？',
        answer:
          '最初の問い合わせでは墓地・霊園名、所在地、必要最小限の区画情報をお知らせください。必要に応じて後から地図や写真を確認します。',
      },
    ];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: title,
    description,
    url: absoluteUrl(path),
    image: absoluteUrl(ogImage),
    provider: { '@id': 'https://www.techvit.me/about/#person' },
    areaServed: {
      '@type': 'AdministrativeArea',
      name: en ? graveCareServiceArea.baseEn : graveCareServiceArea.base,
    },
    offers: graveCarePlans.map((plan) => ({
      '@type': 'Offer',
      name: en ? plan.nameEn : plan.name,
      priceCurrency: 'JPY',
      price: plan.price,
      description: en
        ? `Annual price for ${plan.visitsPerYear} visits, tax included. Paid up front by card.`
        : `年${plan.visitsPerYear}回訪問の年間料金（税込）。クレジットカードによる年間一括前払い。`,
    })),
  },
  buildFaqJsonLd(faqs),
  buildBreadcrumbJsonLd([
    { name: 'TechVit', path: en ? '/en/' : '/' },
    { name: title, path },
  ]),
];

const ctaClass =
  'inline-flex min-h-12 w-full items-center justify-center rounded-md bg-[var(--color-fg)] px-6 py-3 text-base font-medium text-white transition hover:bg-[var(--color-accent)] focus:outline-none focus:ring-2 focus:ring-blue-300 focus:ring-offset-2 sm:w-auto sm:text-sm';
const planCtaClass =
  'inline-flex min-h-12 w-full items-center justify-center rounded-md border border-[var(--color-fg)] px-5 py-3 text-sm font-medium transition hover:bg-[var(--color-fg)] hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-300 focus:ring-offset-2';
const halfWidthSizes = '(min-width: 1024px) 470px, calc(100vw - 3rem)';
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  image={ogImage}
  imageAlt={en ? graveCareImages.hero.altEn : graveCareImages.hero.alt}
  alternates={[
    { lang: 'ja', href: '/grave-care/' },
    { lang: 'en', href: '/en/grave-care/' },
    { lang: 'x-default', href: '/grave-care/' },
  ]}
  jsonLd={jsonLd}
  pageViewEvent="grave_care_view"
>
  <section class="border-b border-[var(--color-border)] bg-[var(--color-bg-subtle)]">
    <div
      class="mx-auto grid max-w-5xl gap-10 px-6 py-12 sm:py-16 lg:grid-cols-[minmax(0,9fr)_minmax(0,11fr)] lg:items-center lg:gap-14 lg:py-20"
    >
      <div class="min-w-0">
        <p class="font-mono text-xs tracking-widest text-[var(--color-accent)]">GRAVE CARE · TOKYO / TAMA</p>
        <h1 class="mt-4 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl lg:text-[2.5rem]">
          {
            en ? (
              <>
                We look after your family grave
                <br class="hidden sm:block" /> four times a year.
              </>
            ) : (
              <>
                東京・多摩のお墓を、
                <br class="hidden sm:block" />
                <span class="whitespace-nowrap">年4回</span>見守ります。
              </>
            )
          }
        </h1>
        <p class="mt-5 text-base leading-8 text-[var(--color-fg-muted)] sm:text-lg">
          {
            en
              ? 'Centered on Nishitokyo and the Tama area: regular visits, light cleaning and photo reports, so you can check the current condition from afar.'
              : '西東京市・多摩地域を中心に、定期訪問、簡易清掃、写真報告。遠くにいても、お墓の今を確認できます。'
          }
        </p>
        <ul class="mt-5 flex flex-wrap gap-2 text-xs font-medium sm:text-sm">
          {
            heroFacts.map((fact) => (
              <li class="rounded-full border border-[var(--color-border)] bg-white px-3 py-1.5">{fact}</li>
            ))
          }
        </ul>
        <div class="mt-8">
          <a href="#inquiry" data-analytics-event="grave_care_cta_click" class={ctaClass}>{ctaLabel}</a>
        </div>
        <p class="mt-3 text-xs text-[var(--color-fg-muted)]">
          {
            en
              ? 'No purchase is required. We first check the location and cemetery rules.'
              : '購入手続きではありません。まず所在地と墓地規則を確認します。'
          }
        </p>
      </div>
      <GraveCareFigure
        image={graveCareImages.hero}
        lang={lang}
        sizes="(min-width: 1024px) 520px, calc(100vw - 3rem)"
        priority
        class="aspect-[16/10] w-full rounded-2xl object-cover object-[60%_50%] lg:aspect-[4/3]"
        caption={imageNotice}
      />
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-14 sm:py-16" aria-labelledby="problems-title">
    <p class="font-mono text-xs text-[var(--color-accent)]">WHO IT IS FOR</p>
    <h2 id="problems-title" class="mt-3 text-2xl font-semibold">
      {en ? 'For families who cannot visit as often as they would like' : '頻繁にお参りできないご家族へ'}
    </h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        problems.map((item) => (
          <li class="rounded-xl border border-[var(--color-border)] p-5 text-sm leading-7">{item}</li>
        ))
      }
    </ul>
  </section>

  <section
    class="border-y border-[var(--color-border)] bg-[var(--color-bg-subtle)]"
    aria-labelledby="service-title"
  >
    <div
      class="mx-auto grid max-w-5xl gap-6 px-6 py-14 sm:py-16 lg:grid-cols-2 lg:grid-rows-[auto_auto] lg:gap-x-12 lg:gap-y-6"
    >
      <div class="lg:col-start-2 lg:row-start-1 lg:self-end">
        <p class="font-mono text-xs text-[var(--color-accent)]">SERVICE</p>
        <h2 id="service-title" class="mt-3 text-2xl font-semibold">
          {en ? 'Careful, hands-on upkeep' : '丁寧にお手入れします'}
        </h2>
        <p class="mt-4 text-sm leading-7 text-[var(--color-fg-muted)]">
          {
            en
              ? 'On each visit we check the plot, wipe the stone, tidy the surroundings and record the result.'
              : '毎回の訪問で墓所を確認し、墓石を拭き、周辺を整え、その結果を記録します。'
          }
        </p>
      </div>
      <GraveCareFigure
        image={graveCareImages.cleaning}
        lang={lang}
        sizes={halfWidthSizes}
        class="aspect-[4/3] w-full rounded-2xl object-cover object-[65%_50%] lg:aspect-[3/2]"
        caption={imageNotice}
        figureClass="min-w-0 lg:col-start-1 lg:row-start-1 lg:row-span-2 lg:self-center"
      />
      <ul class="grid gap-3 sm:grid-cols-2 lg:col-start-2 lg:row-start-2 lg:grid-cols-1 lg:self-start">
        {
          servicePoints.map((point) => (
            <li class="rounded-xl bg-white p-4">
              <p class="flex items-start gap-2 text-sm font-medium">
                <span aria-hidden="true" class="text-[var(--color-accent)]">
                  ✓
                </span>
                {point.label}
              </p>
              <p class="mt-1 pl-5 text-xs leading-5 text-[var(--color-fg-muted)]">{point.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-14 sm:py-16" aria-labelledby="seasons-title">
    <p class="font-mono text-xs text-[var(--color-accent)]">VISIT WINDOWS</p>
    <h2 id="seasons-title" class="mt-3 text-2xl font-semibold">
      {en ? 'Four scheduled visits, one for every season' : '年4回、季節ごとに見守ります。'}
    </h2>
    <p class="mt-4 max-w-2xl text-sm leading-7 text-[var(--color-fg-muted)]">
      {
        en
          ? 'Visits are timed to the spring and autumn equinox periods, Obon and the year end, so the grave is cared for through the whole year. With the two-visit plan you choose two of these periods.'
          : '春彼岸・お盆・秋彼岸・年末。お参りの節目に合わせて巡回し、一年を通してお墓を見守ります。年2回のライトプランでは、この4つの時期から希望の2回をお選びいただけます。'
      }
    </p>
    <GraveCareFigure
      image={graveCareImages.fourSeasons}
      lang={lang}
      sizes="(min-width: 1024px) 976px, calc(100vw - 3rem)"
      class="w-full rounded-2xl"
      caption={imageNotice}
      figureClass="mt-8 min-w-0"
    />
    <ol class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
      {
        graveCareSchedule.map((visit, index) => (
          <li class="rounded-xl border border-[var(--color-border)] p-4 sm:p-5">
            <span class="font-mono text-xs text-[var(--color-accent)]">0{index + 1}</span>
            <h3 class="mt-2 font-semibold">{en ? visit.seasonEn : visit.season}</h3>
            <p class="mt-1 text-sm text-[var(--color-fg-muted)]">{en ? visit.monthsEn : visit.months}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-5 text-sm leading-7 text-[var(--color-fg-muted)]">
      {
        en
          ? 'Work is completed sequentially within each period. Requests at the same cemetery are grouped on the same day where practical.'
          : 'ピンポイントの日付指定ではなく、各巡回期間内に順次作業します。同一霊園のご依頼は、可能な限り同日にまとめます。'
      }
    </p>
  </section>

  <section
    class="border-y border-[var(--color-border)] bg-[var(--color-bg-subtle)]"
    aria-labelledby="report-title"
  >
    <div class="mx-auto grid max-w-5xl gap-8 px-6 py-14 sm:py-16 lg:grid-cols-2 lg:items-center lg:gap-12">
      <div>
        <p class="font-mono text-xs text-[var(--color-accent)]">PHOTO REPORT</p>
        <h2 id="report-title" class="mt-3 text-2xl font-semibold">
          {
            en ? (
              'After each visit, we report with photos.'
            ) : (
              <>
                作業後は、
                <br class="sm:hidden" />
                写真でご報告します。
              </>
            )
          }
        </h2>
        <p class="mt-4 text-sm leading-7 text-[var(--color-fg-muted)]">
          {
            en
              ? 'Even from far away, you can see the condition of the grave on arrival and how it looks after the work.'
              : '遠くにお住まいでも、訪問時のお墓の状態と、作業後の様子をご確認いただけます。'
          }
        </p>
        <ul class="mt-6 space-y-2 text-sm leading-6">
          {
            reportPoints.map((point) => (
              <li class="flex gap-2">
                <span aria-hidden="true" class="text-[var(--color-accent)]">
                  ✓
                </span>
                {point}
              </li>
            ))
          }
        </ul>
        <p class="mt-5 text-xs leading-5 text-[var(--color-fg-muted)]">
          {
            en
              ? 'Delivery is planned to be digital. Details are confirmed before contract (see FAQ).'
              : '送付はデジタルを予定しています。詳細はご契約前にご案内します（FAQ参照）。'
          }
        </p>
      </div>
      <GraveCareFigure
        image={graveCareImages.photoReport}
        lang={lang}
        sizes={halfWidthSizes}
        class="aspect-[4/3] w-full rounded-2xl object-cover lg:aspect-[3/2]"
        caption={imageNotice}
      />
    </div>
