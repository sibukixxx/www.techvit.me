---
interface Props {
  eyebrow?: string;
  title: string;
  lead: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="mx-auto max-w-3xl px-6 py-20 sm:py-28">
  {eyebrow && <p class="mb-4 font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]">{eyebrow}</p>}
  <h1 class="text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">{title}</h1>
  <p class="mt-6 max-w-xl text-base leading-relaxed text-[var(--color-fg-muted)]">{lead}</p>
  <div class="mt-8 flex flex-wrap gap-4">
    <slot />
  </div>
</section>
