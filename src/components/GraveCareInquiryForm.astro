---
import { graveCarePlans, graveCarePlanSelectionLabel, graveCareSchedule } from '../lib/grave-care';

interface Props {
  lang?: 'ja' | 'en';
}

const { lang = 'ja' } = Astro.props;
const isEnglish = lang === 'en';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const inputClass =
  'mt-2 block w-full rounded-md border border-[var(--color-border)] px-3 py-2.5 text-base focus:border-[var(--color-accent)] focus:outline-none focus:ring-2 focus:ring-blue-100';
---

<form id="grave-care-form" class="space-y-5" novalidate data-lang={lang}>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="grave-name" class="block text-sm font-medium">{isEnglish ? 'Name' : 'お名前'}</label>
      <input
        id="grave-name"
        name="name"
        type="text"
        required
        maxlength="120"
        autocomplete="name"
        class={inputClass}
      />
    </div>
    <div>
      <label for="grave-email" class="block text-sm font-medium"
        >{isEnglish ? 'Email address' : 'メールアドレス'}</label
      >
      <input
        id="grave-email"
        name="email"
        type="email"
        required
        maxlength="254"
        autocomplete="email"
        class={inputClass}
      />
    </div>
  </div>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="grave-phone" class="block text-sm font-medium"
        >{isEnglish ? 'Phone (optional)' : '電話番号（任意）'}</label
      >
      <input id="grave-phone" name="phone" type="tel" maxlength="40" autocomplete="tel" class={inputClass} />
    </div>
    <div>
      <label for="grave-cemetery" class="block text-sm font-medium"
        >{isEnglish ? 'Cemetery name' : '墓地・霊園名'}</label
      >
      <input id="grave-cemetery" name="cemetery" type="text" required maxlength="160" class={inputClass} />
    </div>
  </div>
  <div>
    <label for="grave-location" class="block text-sm font-medium"
      >{isEnglish ? 'Cemetery location (city/ward is enough)' : '所在地（市区町村までで構いません）'}</label
    >
    <input
      id="grave-location"
      name="location"
      type="text"
      required
      maxlength="200"
      autocomplete="address-level2"
      class={inputClass}
    />
  </div>
  <div>
    <label for="grave-plot" class="block text-sm font-medium"
      >{isEnglish ? 'Plot information (optional)' : '墓所・区画情報（任意）'}</label
    >
    <input
      id="grave-plot"
      name="plot"
      type="text"
      maxlength="300"
      aria-describedby="grave-plot-help"
      class={inputClass}
    />
    <p id="grave-plot-help" class="mt-1.5 text-xs text-[var(--color-fg-muted)]">
      {
        isEnglish
          ? 'Please do not enter information unrelated to locating the grave.'
          : '墓所の確認に不要な個人情報は入力しないでください。'
      }
    </p>
  </div>
  <div>
    <label for="grave-plan" class="block text-sm font-medium"
      >{isEnglish ? 'Preferred plan' : '希望プラン'}</label
    >
    <select id="grave-plan" name="plan" required class={`${inputClass} bg-white`}>
      <option value="">{isEnglish ? 'Select one' : '選択してください'}</option>
      {
        graveCarePlans.map((plan) => (
          <option value={plan.id}>{graveCarePlanSelectionLabel(plan.id, lang)}</option>
        ))
      }
      <option value="UNDECIDED">{graveCarePlanSelectionLabel('UNDECIDED', lang)}</option>
    </select>
  </div>
  <fieldset>
    <legend class="block text-sm font-medium">
      {isEnglish ? 'Preferred visit periods (optional)' : '希望する訪問時期（任意・複数選択可）'}
    </legend>
    <p class="mt-1.5 text-xs text-[var(--color-fg-muted)]">
      {
        isEnglish
          ? 'The four-visit plan covers all four periods. With the two-visit plan, choose two.'
          : '年4回プランは4つの時期すべてを巡回します。年2回プランは希望の2回をお選びください。'
      }
    </p>
    <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
      {
        graveCareSchedule.map((visit) => (
          <label class="flex min-h-11 cursor-pointer items-center gap-2 rounded-md border border-[var(--color-border)] bg-white px-3 py-2 text-sm">
            <input type="checkbox" name="preferredVisitPeriods" value={visit.id} class="h-4 w-4" />
            <span>
              {isEnglish ? visit.seasonEn : visit.season}
              <span class="block text-xs text-[var(--color-fg-muted)]">
                {isEnglish ? visit.monthsEn : visit.months}
              </span>
            </span>
          </label>
        ))
      }
    </div>
  </fieldset>
  <div>
    <label for="grave-notes" class="block text-sm font-medium"
      >{isEnglish ? 'Notes (optional)' : '備考（任意）'}</label
    >
    <textarea id="grave-notes" name="notes" rows="4" maxlength="5000" class={inputClass}></textarea>
  </div>
  <label class="flex items-start gap-3 text-sm leading-6">
    <input id="grave-privacy" name="privacyConsent" type="checkbox" required class="mt-1 h-4 w-4 shrink-0" />
    <span>
      {
        isEnglish
          ? 'I agree that the information above is used only to assess and reply to this inquiry.'
          : '入力した情報を、このお問い合わせの対応可否確認と返信のために利用することに同意します。'
      }
    </span>
  </label>
  {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-callback="onGraveCareTurnstileSuccess" />}
  <button
    id="grave-care-submit"
    type="submit"
    class="inline-flex min-h-12 w-full items-center justify-center rounded-md bg-[var(--color-fg)] px-5 py-2.5 text-base font-medium text-white transition-colors hover:bg-[var(--color-accent)] focus:outline-none focus:ring-2 focus:ring-blue-300 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 sm:w-auto sm:text-sm"
  >
    {isEnglish ? 'Ask about availability' : '対応可能か相談する'}
  </button>
  <p class="text-xs text-[var(--color-fg-muted)]">
    {
      isEnglish
        ? 'No payment is taken here. If we can help, we send a link to Square’s secure checkout page by email.'
        : 'この送信でお支払いは発生しません。対応可能な場合、Squareの決済ページのリンクをメールでご案内します。'
    }
  </p>
  <p id="grave-care-status" role="status" aria-live="polite" class="text-sm"></p>
</form>

{siteKey && <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js" />}

<script>
  const form = document.querySelector<HTMLFormElement>('#grave-care-form');
  const submit = document.querySelector<HTMLButtonElement>('#grave-care-submit');
  const status = document.querySelector<HTMLParagraphElement>('#grave-care-status');
  const planSelect = document.querySelector<HTMLSelectElement>('#grave-plan');
  const isEnglish = form?.dataset.lang === 'en';
  let turnstileToken = '';
  let started = false;

  const track = (eventName: string, parameters: Record<string, string> = {}) => {
    const analyticsWindow = window as typeof window & {
      gtag?: (...args: unknown[]) => void;
      dataLayer?: unknown[];
    };
    if (typeof analyticsWindow.gtag === 'function') analyticsWindow.gtag('event', eventName, parameters);
    else analyticsWindow.dataLayer?.push({ event: eventName, ...parameters });
  };

  // Preselect the plan from a pricing-card CTA (data-plan) or a ?plan= query parameter.
  const selectPlan = (value: string | null) => {
    if (!planSelect || !value) return;
    const isKnown = Array.from(planSelect.options).some((option) => option.value === value);
    if (isKnown) planSelect.value = value;
  };
  selectPlan(new URLSearchParams(window.location.search).get('plan'));
  document.querySelectorAll<HTMLAnchorElement>('a[href="#inquiry"][data-plan]').forEach((link) => {
    link.addEventListener('click', () => selectPlan(link.dataset.plan ?? null));
  });

  (
    window as typeof window & { onGraveCareTurnstileSuccess?: (token: string) => void }
  ).onGraveCareTurnstileSuccess = (token) => {
    turnstileToken = token;
  };

  form?.addEventListener('focusin', () => {
    if (!started) {
      started = true;
      track('grave_care_inquiry_start', { source_path: window.location.pathname });
    }
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    if (document.querySelector('.cf-turnstile') && !turnstileToken) {
      if (status)
        status.textContent = isEnglish
          ? 'Verification is still in progress.'
          : '確認中です。少し待ってから再度お試しください。';
      return;
    }

    const data = new FormData(form);
    const query = new URLSearchParams(window.location.search);
    const plan = String(data.get('plan') ?? '');
    const payload = {
      kind: 'grave-care',
      topic: 'grave-care',
      name: data.get('name'),
      email: data.get('email'),
      phone: data.get('phone'),
      cemetery: data.get('cemetery'),
      location: data.get('location'),
      plot: data.get('plot'),
      plan,
      preferredVisitPeriods: data.getAll('preferredVisitPeriods'),
      notes: data.get('notes'),
      privacyConsent: data.get('privacyConsent') === 'on',
      turnstileToken,
      utmSource: query.get('utm_source') ?? '',
      utmMedium: query.get('utm_medium') ?? '',
      utmCampaign: query.get('utm_campaign') ?? '',
      landingPage: window.location.pathname,
    };

    if (submit) submit.disabled = true;
    if (status) status.textContent = isEnglish ? 'Sending…' : '送信中です…';
    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!response.ok) throw new Error('Request failed');
      // Only the plan id and path are sent to analytics; never personal or plot data.
      track('grave_care_inquiry_submit', { source_path: window.location.pathname, plan });
      if (status)
        status.textContent = isEnglish
          ? 'Thank you. We will confirm availability and get back to you.'
          : '送信しました。対応可否を確認してご連絡します。';
      form.reset();
    } catch {
      if (status)
        status.textContent = isEnglish
          ? 'Could not send. Please try again later.'
          : '送信に失敗しました。時間をおいて再度お試しください。';
    } finally {
      if (submit) submit.disabled = false;
    }
  });
</script>
