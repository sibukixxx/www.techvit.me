---
interface Props {
  title: string;
  description: string;
  category: string;
  url: string;
  icon: 'automation' | 'chat' | 'lab' | 'factory';
}

const { title, description, category, url, icon } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener"
  class="group flex h-full flex-col rounded-lg border border-[var(--color-border)] p-6 transition-colors hover:border-[var(--color-accent)]"
>
  <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-lg bg-blue-50 text-[var(--color-accent)] transition-colors group-hover:bg-blue-100">
    {
      icon === 'automation' && (
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="6" height="5" rx="1" />
          <rect x="15" y="15" width="6" height="5" rx="1" />
          <path d="M9 6.5h3a4 4 0 0 1 4 4V15M12.5 12.5 16 15l2.5-3" />
        </svg>
      )
    }
    {
      icon === 'chat' && (
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 9.5 9.5 0 0 1-3-.5L4 20l1.5-4A7 7 0 0 1 4 11.5C4 7.4 7.6 4 12 4s8 3.4 8 7.5Z" />
          <path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01" />
        </svg>
      )
    }
    {
      icon === 'lab' && (
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 3h6M10 3v6l-5 8.5A2.3 2.3 0 0 0 7 21h10a2.3 2.3 0 0 0 2-3.5L14 9V3" />
          <path d="M7.5 15h9M10 18h.01M14 17h.01" />
        </svg>
      )
    }
    {
      icon === 'factory' && (
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 21V9l6 3V8l6 4V5h4l2 16H3Z" />
          <path d="M7 16h2M12 16h2M17 16h2M7 19h2M12 19h2M17 19h2" />
        </svg>
      )
    }
  </div>
  <p class="text-xs font-medium uppercase tracking-wide text-[var(--color-fg-muted)]">{category}</p>
  <h3 class="mt-2 text-lg font-semibold group-hover:text-[var(--color-accent)]">{title}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--color-fg-muted)]">{description}</p>
  <span class="mt-5 text-sm text-[var(--color-accent)]">Visit site ↗</span>
</a>
