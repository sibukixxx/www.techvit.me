---
interface Props {
  title: string;
  description: string;
  category: string;
  url: string;
}

const { title, description, category, url } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener"
  class="group flex h-full flex-col rounded-lg border border-[var(--color-border)] p-6 transition-colors hover:border-[var(--color-accent)]"
>
  <p class="text-xs font-medium uppercase tracking-wide text-[var(--color-fg-muted)]">{category}</p>
  <h3 class="mt-2 text-lg font-semibold group-hover:text-[var(--color-accent)]">{title}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--color-fg-muted)]">{description}</p>
  <span class="mt-5 text-sm text-[var(--color-accent)]">Visit site ↗</span>
</a>
