---
const currentPath = Astro.url.pathname;
const isEnglish = currentPath === '/en' || currentPath.startsWith('/en/');
const isEnglishWriting = currentPath.startsWith('/en/writing');
const isJapaneseBlog = currentPath.startsWith('/blog');
const localizedServicePaths = [
  '/services/automation-development/',
  '/services/rag-knowledge-search/',
  '/services/web-saas-development/',
];
const hasLocalizedService = localizedServicePaths.includes(
  currentPath.startsWith('/en/') ? currentPath.slice(3) : currentPath,
);
const hasLanguageAlternate =
  ['/', '/about/', '/contact/', '/services/', '/en/', '/en/about/', '/en/contact/', '/en/services/'].includes(
    currentPath,
  ) ||
  currentPath.startsWith('/projects/') ||
  currentPath.startsWith('/lab/') ||
  currentPath.startsWith('/en/projects/') ||
  currentPath.startsWith('/en/lab/') ||
  hasLocalizedService ||
  isJapaneseBlog ||
  isEnglishWriting;
const alternateLanguagePath = isEnglishWriting
  ? currentPath.replace(/^\/en\/writing/, '/blog')
  : isJapaneseBlog
    ? currentPath.replace(/^\/blog/, '/en/writing')
    : isEnglish
      ? currentPath.replace(/^\/en(?=\/|$)/, '') || '/'
      : `/en${currentPath}`;

const navItems = [
  { href: isEnglish ? '/en/services' : '/services', label: isEnglish ? 'Services' : 'サービス' },
  ...(!isEnglish
    ? [
        { href: '/solutions', label: '課題から探す' },
        { href: '/open-source', label: '事例・ツール' },
      ]
    : []),
  { href: isEnglish ? '/en/writing' : '/blog', label: 'Blog' },
  { href: isEnglish ? '/en/about' : '/about', label: isEnglish ? 'About' : 'TechVitについて' },
];

function isActive(href: string) {
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-bg)]/90 backdrop-blur">
  <div class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4 md:py-5">
    <a
      href={isEnglish ? '/en/' : '/'}
      class="flex items-center gap-2 font-mono text-sm font-semibold tracking-tight"
    >
      <img src="/logo-mark.png" alt="" width="28" height="28" class="size-7" decoding="async" />
      techvit
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-5 text-sm md:flex lg:gap-6">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'transition-colors hover:text-[var(--color-accent)]',
              isActive(item.href) ? 'text-[var(--color-fg)] font-medium' : 'text-[var(--color-fg-muted)]',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={isEnglish ? '/en/contact' : '/contact'}
        class="rounded-md bg-[var(--color-fg)] px-3 py-2 text-xs font-medium text-[var(--color-accent-fg)] transition-colors hover:bg-[var(--color-accent)]"
      >
        {isEnglish ? 'Contact' : '相談する'}
      </a>
      {
        hasLanguageAlternate && (
          <a
            href={alternateLanguagePath}
            hreflang={isEnglish ? 'ja' : 'en'}
            class="font-mono text-xs text-[var(--color-fg-muted)] transition-colors hover:text-[var(--color-accent)]"
          >
            {isEnglish ? 'JA' : 'EN'}
          </a>
        )
      }
    </nav>

    <button
      type="button"
      id="menu-button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={isEnglish ? 'Toggle menu' : 'メニューを開閉'}
      class="group -mr-2 p-2 text-[var(--color-fg)] md:hidden"
    >
      <svg
        class="size-5 group-aria-expanded:hidden"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M3 5.5h14M3 10h14M3 14.5h14"></path>
      </svg>
      <svg
        class="hidden size-5 group-aria-expanded:block"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M5 5l10 10M15 5L5 15"></path>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Primary"
    hidden
    class="border-t border-[var(--color-border)] px-6 py-3 md:hidden"
  >
    <ul>
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'block py-2.5 text-sm transition-colors hover:text-[var(--color-accent)]',
                isActive(item.href) ? 'text-[var(--color-fg)] font-medium' : 'text-[var(--color-fg-muted)]',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="mt-2 border-t border-[var(--color-border)] pt-2">
        <a
          href={isEnglish ? '/en/contact' : '/contact'}
          class="block py-2.5 text-sm font-medium text-[var(--color-accent)]"
        >
          {isEnglish ? 'Contact' : '相談する'}
        </a>
        {
          hasLanguageAlternate && (
            <a
              href={alternateLanguagePath}
              hreflang={isEnglish ? 'ja' : 'en'}
              class="block py-2.5 font-mono text-xs text-[var(--color-fg-muted)] transition-colors hover:text-[var(--color-accent)]"
            >
              {isEnglish ? '日本語' : 'English'}
            </a>
          )
        }
      </li>
    </ul>
  </nav>
</header>

<script>
  const button = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');

  if (button && menu) {
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
    };

    button.addEventListener('click', () => setOpen(menu.hidden));

    // ハッシュリンク（/#products など）はページ遷移しないことがあるため、タップで閉じる
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        button.focus();
      }
    });
  }
</script>
