---
import Nav from './Nav.astro';

const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
---

<header class="border-b border-[var(--color-border)]">
  <div class="mx-auto flex max-w-4xl items-center justify-between px-6 py-5">
    <a href={isEnglish ? '/en/' : '/'} class="font-mono text-sm font-semibold tracking-tight">
      techvit
    </a>
    <Nav />
  </div>
</header>
