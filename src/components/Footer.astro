---
const year = new Date().getFullYear();
const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
---

<footer class="border-t border-[var(--color-border)]">
  <div
    class="mx-auto flex max-w-4xl flex-col gap-4 px-6 py-10 text-sm text-[var(--color-fg-muted)] sm:flex-row sm:items-center sm:justify-between"
  >
    <p>&copy; {year} techvit</p>
    <div class="flex gap-5">
      <a href={isEnglish ? '/en/contact' : '/contact'} class="hover:text-[var(--color-accent)]">Contact</a>
      <a href={isEnglish ? '/en/writing' : '/writing'} class="hover:text-[var(--color-accent)]">Writing</a>
      <a href="https://github.com/sibukixxx" class="hover:text-[var(--color-accent)]" rel="me noopener" target="_blank">
        GitHub
      </a>
    </div>
  </div>
</footer>
