---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
}

const { href, variant = 'primary' } = Astro.props;

const styles =
  variant === 'primary'
    ? 'bg-[var(--color-fg)] text-[var(--color-accent-fg)] hover:bg-[var(--color-accent)]'
    : 'border border-[var(--color-border)] text-[var(--color-fg)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]';
---

<a
  href={href}
  class:list={['inline-flex items-center rounded-md px-4 py-2 text-sm font-medium transition-colors', styles]}
>
  <slot />
</a>
