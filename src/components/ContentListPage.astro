---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from './Card.astro';

interface ListItem {
  href: string;
  title: string;
  description: string;
  eyebrow?: string;
  meta?: string;
}

interface Props {
  title: string;
  description: string;
  lang?: 'ja' | 'en';
  items: ListItem[];
}

const { title, description, lang = 'ja', items } = Astro.props;
---

<BaseLayout title={title} description={description} lang={lang}>
  <section class="mx-auto max-w-4xl px-6 py-20">
    <h1 class="text-2xl font-semibold">{title}</h1>
    <p class="mt-4 max-w-xl text-sm leading-relaxed text-[var(--color-fg-muted)]">{description}</p>

    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      {items.map((item) => <Card {...item} />)}
    </div>
  </section>
</BaseLayout>
