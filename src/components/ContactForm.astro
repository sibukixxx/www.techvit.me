---
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
interface Props {
  lang?: 'ja' | 'en';
}
const { lang = 'ja' } = Astro.props;
const isEnglish = lang === 'en';
const topic = Astro.url.searchParams.get('topic');
const topicLabels: Record<string, string> = {
  'excel-automation': 'Excel作業の自動化',
  'document-automation': '文書作業の自動化',
  'email-automation': 'メール対応の自動化',
  'internal-search': '社内資料検索・RAG',
  'sales-research-automation': '営業リサーチ自動化',
  'wordpress-modernization': 'WordPress移行',
  'rag-accuracy': 'RAG品質改善',
  'customer-feedback-analysis': '顧客インサイト分析',
  'performance-regression': '性能試験・回帰分析',
  'technical-proof': '技術検証',
};
const prefill = !isEnglish && topic && topicLabels[topic] ? `相談したい内容: ${topicLabels[topic]}\n\n` : '';
const isRAGTopic = topic === 'internal-search' || topic === 'rag-accuracy' || topic === 'technical-proof';
---

<form id="contact-form" class="mt-10 space-y-6" novalidate>
  <div>
    <label for="name" class="block text-sm font-medium">{isEnglish ? 'Name' : 'お名前'}</label>
    <input
      id="name"
      name="name"
      type="text"
      required
      autocomplete="name"
      class="mt-2 block w-full rounded-md border border-[var(--color-border)] px-3 py-2 text-sm focus:border-[var(--color-accent)] focus:outline-none"
    />
  </div>

  <div>
    <label for="email" class="block text-sm font-medium"
      >{isEnglish ? 'Work email address' : '勤務先メールアドレス'}</label
    >
    <input
      id="email"
      name="email"
      type="email"
      required
      autocomplete="email"
      class="mt-2 block w-full rounded-md border border-[var(--color-border)] px-3 py-2 text-sm focus:border-[var(--color-accent)] focus:outline-none"
    />
  </div>

  <div>
    <label for="company" class="block text-sm font-medium"
      >{isEnglish ? 'Company / organization' : '勤務先・組織名'}</label
    >
    <input
      id="company"
      name="company"
      type="text"
      required
      maxlength="120"
      autocomplete="organization"
      class="mt-2 block w-full rounded-md border border-[var(--color-border)] px-3 py-2 text-sm focus:border-[var(--color-accent)] focus:outline-none"
    />
  </div>

  <label class="flex items-start gap-3 rounded-md border border-[var(--color-border)] p-4 text-sm">
    <input
      id="demo-requested"
      name="demoRequested"
      type="checkbox"
      checked={isRAGTopic}
      class="mt-0.5 h-4 w-4 accent-[var(--color-accent)]"
    />
    <span>
      <strong class="block font-medium">{isEnglish ? 'Request a ForgeAI demo account' : 'ForgeAIのデモ利用を希望する'}</strong>
      <span class="mt-1 block text-[var(--color-fg-muted)]">
        {isEnglish
          ? 'After review, we will issue an individual, time-limited account to this email address.'
          : '内容確認後、このメールアドレス専用の期限付きアカウントをご案内します。'}
      </span>
    </span>
  </label>

  <div>
    <label for="message" class="block text-sm font-medium"
      >{isEnglish ? 'How can I help?' : 'お問い合わせ内容'}</label
    >
    <textarea
      id="message"
      name="message"
      rows="6"
      required
      class="mt-2 block w-full rounded-md border border-[var(--color-border)] px-3 py-2 text-sm focus:border-[var(--color-accent)] focus:outline-none"
      >{prefill}</textarea
    >
  </div>

  {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-callback="onTurnstileSuccess" />}

  <div>
    <button
      id="contact-submit"
      type="submit"
      class="inline-flex items-center rounded-md bg-[var(--color-fg)] px-4 py-2 text-sm font-medium text-[var(--color-accent-fg)] transition-colors hover:bg-[var(--color-accent)] disabled:cursor-not-allowed disabled:opacity-50"
    >
      {isEnglish ? 'Send message' : '送信する'}
    </button>
  </div>

  <p id="contact-status" role="status" class="text-sm"></p>
</form>

{siteKey && <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js" />}

<script>
  const messages = {
    verification:
      document.documentElement.lang === 'en'
        ? 'Verification is still in progress. Please try again shortly.'
        : '確認中です。少し待ってから再度お試しください。',
    sending: document.documentElement.lang === 'en' ? 'Sending...' : '送信中...',
    success:
      document.documentElement.lang === 'en'
        ? 'Your message has been sent. Thank you.'
        : '送信しました。ありがとうございます。',
    failure:
      document.documentElement.lang === 'en'
        ? 'The message could not be sent. Please try again later.'
        : '送信に失敗しました。時間をおいて再度お試しください。',
  };
  let turnstileToken = '';

  (window as unknown as { onTurnstileSuccess: (token: string) => void }).onTurnstileSuccess = (
    token: string,
  ) => {
    turnstileToken = token;
  };

  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const submitButton = document.querySelector<HTMLButtonElement>('#contact-submit');
  const status = document.querySelector<HTMLParagraphElement>('#contact-status');
  const hasTurnstile = document.querySelector('.cf-turnstile') !== null;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    if (hasTurnstile && !turnstileToken) {
      if (status) status.textContent = messages.verification;
      return;
    }

    const formData = new FormData(form);
    const payload = {
      name: formData.get('name'),
      email: formData.get('email'),
      company: formData.get('company'),
      message: formData.get('message'),
      topic: new URLSearchParams(window.location.search).get('topic') ?? '',
      demoRequested: formData.get('demoRequested') === 'on',
      turnstileToken,
    };

    if (submitButton) submitButton.disabled = true;
    if (status) status.textContent = messages.sending;

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!response.ok) {
        throw new Error('送信に失敗しました');
      }

      if (status) status.textContent = messages.success;
      form.reset();
    } catch {
      if (status) status.textContent = messages.failure;
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });
</script>
