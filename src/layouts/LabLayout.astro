---
import BaseLayout from './BaseLayout.astro';
import Tag from '../components/Tag.astro';
import { labStatusLabels } from '../lib/content';
import { buildCreativeWorkJsonLd, absoluteUrl } from '../lib/seo';
import type { CollectionEntry } from 'astro:content';

interface Props {
  item: CollectionEntry<'lab'>;
}

const { item } = Astro.props;
const { title, description, status, externalUrl } = item.data;

const jsonLd = buildCreativeWorkJsonLd({
  title,
  description,
  url: absoluteUrl(`/lab/${item.id}`),
});
---

<BaseLayout title={title} description={description} type="article" jsonLd={jsonLd}>
  <article class="mx-auto max-w-2xl px-6 py-20">
    <a href="/lab" class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)]">← Lab</a>

    <header class="mt-6">
      <Tag label={labStatusLabels[status]} />
      <h1 class="mt-4 text-2xl font-semibold">{title}</h1>
      <p class="mt-3 text-sm leading-relaxed text-[var(--color-fg-muted)]">{description}</p>
      {
        externalUrl && (
          <a href={externalUrl} class="mt-4 inline-block text-sm text-[var(--color-accent)] hover:underline" rel="noopener" target="_blank">
            Visit →
          </a>
        )
      }
    </header>

    <div class="prose mt-10 text-[15px]">
      <slot />
    </div>
  </article>
</BaseLayout>
