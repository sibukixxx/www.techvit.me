---
import BaseLayout from './BaseLayout.astro';
import Tag from '../components/Tag.astro';
import { labStatusLabels } from '../lib/content';
import { buildCreativeWorkJsonLd, buildBreadcrumbJsonLd, absoluteUrl } from '../lib/seo';
import type { CollectionEntry } from 'astro:content';

interface Props {
  item: CollectionEntry<'lab'> | CollectionEntry<'labEn'>;
  lang?: 'ja' | 'en';
}

const { item, lang = 'ja' } = Astro.props;
const isEnglish = lang === 'en';
const basePath = isEnglish ? '/en/lab' : '/lab';
const { title, description, status, externalUrl } = item.data;

const jsonLd = [
  buildCreativeWorkJsonLd({
    title,
    description,
    url: absoluteUrl(`${basePath}/${item.id}`),
  }),
  buildBreadcrumbJsonLd([
    { name: 'Home', path: lang === 'en' ? '/en/' : '/' },
    { name: 'Lab', path: `${basePath}/` },
    { name: title, path: `${basePath}/${item.id}/` },
  ]),
];
---

<BaseLayout title={title} description={description} lang={lang} type="article" jsonLd={jsonLd}>
  <article class="mx-auto max-w-2xl px-6 py-20">
    <a href={basePath} class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)]">← Lab</a>

    <header class="mt-6">
      <Tag label={labStatusLabels[status]} />
      <h1 class="mt-4 text-2xl font-semibold">{title}</h1>
      <p class="mt-3 text-sm leading-relaxed text-[var(--color-fg-muted)]">{description}</p>
      {
        externalUrl && (
          <a href={externalUrl} class="mt-4 inline-block text-sm text-[var(--color-accent)] hover:underline" rel="noopener" target="_blank">
            Visit →
          </a>
        )
      }
    </header>

    <div class="prose mt-10 text-[15px]">
      <slot />
    </div>
  </article>
</BaseLayout>
