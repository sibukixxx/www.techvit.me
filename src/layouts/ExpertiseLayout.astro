---
import { getEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import { buildCreativeWorkJsonLd, buildBreadcrumbJsonLd, absoluteUrl } from '../lib/seo';
import type { CollectionEntry } from 'astro:content';

interface Props {
  expertise: CollectionEntry<'expertise'>;
}

const { expertise } = Astro.props;
const { title, summary, highlights, relatedServices, relatedProjects, relatedWriting } = expertise.data;

const jsonLd = [
  buildCreativeWorkJsonLd({
    title,
    description: summary,
    url: absoluteUrl(`/expertise/${expertise.id}/`),
  }),
  buildBreadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Expertise', path: '/expertise/' },
    { name: title, path: `/expertise/${expertise.id}/` },
  ]),
];

const serviceEntries = (await Promise.all(relatedServices.map((id) => getEntry('services', id)))).filter(
  (entry): entry is NonNullable<typeof entry> => Boolean(entry),
);
const projectEntries = (await Promise.all(relatedProjects.map((id) => getEntry('projects', id)))).filter(
  (entry): entry is NonNullable<typeof entry> => Boolean(entry),
);
const writingEntries = (await Promise.all(relatedWriting.map((id) => getEntry('writing', id)))).filter(
  (entry): entry is NonNullable<typeof entry> => Boolean(entry),
);
---

{/* Expertise にはまだ英語版がないため、存在しないhreflangを自動生成させない */}
<BaseLayout title={title} description={summary} type="article" jsonLd={jsonLd} alternates={[]}>
  <article class="mx-auto max-w-2xl px-6 py-20">
    <a href="/expertise" class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)]">← Expertise</a>

    <header class="mt-6">
      <h1 class="text-2xl font-semibold">{title}</h1>
      <p class="mt-3 text-sm leading-relaxed text-[var(--color-fg-muted)]">{summary}</p>
    </header>

    <section class="mt-10">
      <h2 class="text-xs font-medium uppercase tracking-wide text-[var(--color-fg-muted)]">対応範囲</h2>
      <ul class="mt-3 space-y-2 text-sm leading-relaxed text-[var(--color-fg-muted)]">
        {highlights.map((item) => <li class="flex gap-2"><span aria-hidden="true">・</span>{item}</li>)}
      </ul>
    </section>

    <div class="prose mt-10 text-[15px]">
      <slot />
    </div>

    {
      (serviceEntries.length > 0 || projectEntries.length > 0 || writingEntries.length > 0) && (
        <section class="mt-12">
          <h2 class="text-xs font-medium uppercase tracking-wide text-[var(--color-fg-muted)]">関連するService・実績・記事</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {serviceEntries.map((entry) => (
              <Card href={`/services/${entry.id}`} title={entry.data.title} description={entry.data.summary} eyebrow="Service" />
            ))}
            {projectEntries.map((entry) => (
              <Card href={`/projects/${entry.id}`} title={entry.data.title} description={entry.data.description} eyebrow="Project" />
            ))}
            {writingEntries.map((entry) => (
              <Card href={`/writing/${entry.id}`} title={entry.data.title} description={entry.data.description} eyebrow="Writing" />
            ))}
          </div>
        </section>
      )
    }

    <div class="mt-12 text-center">
      <Button href="/contact">この領域について相談する</Button>
    </div>
  </article>
</BaseLayout>
