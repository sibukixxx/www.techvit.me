---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ShareBar from '../components/ShareBar.astro';
import { buildOrganizationJsonLd } from '../lib/seo';
import { findQuestionByLandingPath } from '../lib/demand';

interface Props {
  title: string;
  description: string;
  lang?: 'ja' | 'en';
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  alternates?: { lang: string; href: string }[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  pageViewEvent?: string;
}

const {
  title,
  description,
  lang = 'ja',
  image,
  imageAlt,
  type,
  noindex,
  alternates,
  jsonLd,
  pageViewEvent,
} = Astro.props;
const pageJsonLd = [
  buildOrganizationJsonLd(),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
const currentPath = Astro.url.pathname;
const demandQuestion = findQuestionByLandingPath(currentPath);
const isEnglishWriting = currentPath.startsWith('/en/writing');
const isJapaneseBlog = currentPath.startsWith('/blog');
const localizedServicePaths = [
  '/services/automation-development/',
  '/services/rag-knowledge-search/',
  '/services/web-saas-development/',
];
const hasLocalizedService = localizedServicePaths.includes(
  currentPath.startsWith('/en/') ? currentPath.slice(3) : currentPath,
);
const japanesePath = isEnglishWriting
  ? currentPath.replace(/^\/en\/writing/, '/blog')
  : currentPath.startsWith('/en/')
    ? currentPath.slice(3) || '/'
    : currentPath;
const englishPath = isJapaneseBlog
  ? currentPath.replace(/^\/blog/, '/en/writing')
  : currentPath.startsWith('/en/')
    ? currentPath
    : `/en${currentPath}`;
const hasLocalizedCounterpart =
  ['/', '/about/', '/contact/', '/services/', '/en/', '/en/about/', '/en/contact/', '/en/services/'].includes(
    currentPath,
  ) ||
  currentPath.startsWith('/projects/') ||
  currentPath.startsWith('/lab/') ||
  currentPath.startsWith('/en/projects/') ||
  currentPath.startsWith('/en/lab/') ||
  currentPath === '/grave-care/' ||
  currentPath === '/en/grave-care/' ||
  hasLocalizedService ||
  isJapaneseBlog ||
  isEnglishWriting;
const localizedAlternates =
  alternates ??
  (noindex || !hasLocalizedCounterpart
    ? []
    : [
        { lang: 'ja', href: japanesePath },
        { lang: 'en', href: englishPath },
        { lang: 'x-default', href: japanesePath },
      ]);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-KKVQJLPCBY"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        // Google tag commands must retain the Arguments object shape.
        // eslint-disable-next-line prefer-rest-params
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-KKVQJLPCBY');
    </script>
    <SEO
      title={title}
      description={description}
      lang={lang}
      image={image}
      imageAlt={imageAlt}
      type={type}
      noindex={noindex}
      alternates={localizedAlternates}
      jsonLd={pageJsonLd}
    />
  </head>
  <body
    class="flex min-h-screen flex-col"
    data-page-view-event={pageViewEvent}
    data-question-id={demandQuestion?.questionId}
    data-experiment-id={demandQuestion?.experimentId ?? undefined}
    data-content-version={demandQuestion?.contentVersion ?? undefined}
    data-service-ref={demandQuestion?.serviceRef}
  >
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    {!noindex && <ShareBar title={title} lang={lang} />}
    <Footer />
    <script>
      import {
        ctaIdFromHref,
        landingPageId,
        readStoredDemandContext,
        sanitizeDemandContext,
        sourceFromReferrer,
        writeStoredDemandContext,
        type DemandContext,
      } from '../lib/demand';

      declare global {
        interface Window {
          dataLayer?: Record<string, unknown>[];
          gtag?: (...args: unknown[]) => void;
        }
      }

      const track = (eventName: string, parameters: Record<string, string> = {}) => {
        if (typeof window.gtag === 'function') {
          window.gtag('event', eventName, parameters);
          return;
        }
        window.dataLayer?.push({ event: eventName, ...parameters });
      };

      document
        .querySelectorAll<HTMLAnchorElement>('a[href^="/contact"], a[href^="/en/contact"]')
        .forEach((link) => {
          link.addEventListener('click', () => {
            track('contact_click', {
              source_path: window.location.pathname,
              cta_label: link.textContent?.trim() ?? '',
            });
          });
        });

      document.querySelectorAll<HTMLElement>('[data-analytics-event]').forEach((element) => {
        element.addEventListener('click', () => {
          const eventName = element.dataset.analyticsEvent;
          if (eventName) {
            track(eventName, {
              source_path: window.location.pathname,
              cta_label: element.textContent?.trim() ?? '',
              ...(element.dataset.analyticsPlan ? { plan: element.dataset.analyticsPlan } : {}),
            });
          }
        });
      });

      const pageViewEvent = document.body.dataset.pageViewEvent;
      if (pageViewEvent) track(pageViewEvent, { page_path: window.location.pathname });

      // Demand Learning (#25): remember the question landing for this session so that
      // decision CTAs and the contact form can carry the same ID family. IDs only, no PII.
      const readDemandContext = () => readStoredDemandContext(sessionStorage);
      const writeDemandContext = (context: DemandContext) =>
        writeStoredDemandContext(sessionStorage, context);

      const { questionId, experimentId, contentVersion, serviceRef } = document.body.dataset;
      if (questionId) {
        const landing = sanitizeDemandContext({
          question_id: questionId,
          experiment_id: experimentId,
          content_version: contentVersion,
          service_ref: serviceRef,
          landing_page_id: landingPageId(window.location.pathname),
          source: sourceFromReferrer(document.referrer, window.location.hostname),
          campaign: new URLSearchParams(window.location.search).get('utm_campaign') ?? undefined,
        });
        writeDemandContext(landing);
        track('demand_landing', { ...landing, occurred_at: new Date().toISOString() });
      }

      document.addEventListener('click', (event) => {
        const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[href]');
        const ctaId = link ? ctaIdFromHref(link.getAttribute('href') ?? '') : undefined;
        const context = readDemandContext();
        if (!ctaId || !context.question_id) return;
        writeDemandContext({ ...context, cta_id: ctaId });
        track('demand_cta_click', {
          ...context,
          cta_id: ctaId,
          source_path: window.location.pathname,
          occurred_at: new Date().toISOString(),
        });
      });
    </script>
  </body>
</html>
