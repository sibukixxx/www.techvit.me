---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ShareBar from '../components/ShareBar.astro';
import { buildOrganizationJsonLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  lang?: 'ja' | 'en';
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  alternates?: { lang: string; href: string }[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, lang = 'ja', image, imageAlt, type, noindex, alternates, jsonLd } = Astro.props;
const pageJsonLd = [
  buildOrganizationJsonLd(),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
const currentPath = Astro.url.pathname;
const isEnglishWriting = currentPath.startsWith('/en/writing');
const isJapaneseBlog = currentPath.startsWith('/blog');
const japanesePath = isEnglishWriting
  ? currentPath.replace(/^\/en\/writing/, '/blog')
  : currentPath.startsWith('/en/')
    ? currentPath.slice(3) || '/'
    : currentPath;
const englishPath = isJapaneseBlog
  ? currentPath.replace(/^\/blog/, '/en/writing')
  : currentPath.startsWith('/en/')
    ? currentPath
    : `/en${currentPath}`;
const hasLocalizedCounterpart =
  ['/', '/about/', '/contact/', '/services/', '/en/', '/en/about/', '/en/contact/', '/en/services/'].includes(
    currentPath,
  ) ||
  currentPath.startsWith('/projects/') ||
  currentPath.startsWith('/lab/') ||
  currentPath.startsWith('/en/projects/') ||
  currentPath.startsWith('/en/lab/') ||
  isJapaneseBlog ||
  isEnglishWriting;
const localizedAlternates =
  alternates ??
  (noindex || !hasLocalizedCounterpart
    ? []
    : [
        { lang: 'ja', href: japanesePath },
        { lang: 'en', href: englishPath },
        { lang: 'x-default', href: japanesePath },
      ]);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      description={description}
      lang={lang}
      image={image}
      imageAlt={imageAlt}
      type={type}
      noindex={noindex}
      alternates={localizedAlternates}
      jsonLd={pageJsonLd}
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    {!noindex && <ShareBar title={title} lang={lang} />}
    <Footer />
    <script>
      declare global {
        interface Window {
          dataLayer?: Record<string, unknown>[];
          gtag?: (...args: unknown[]) => void;
        }
      }

      const track = (eventName: string, parameters: Record<string, string> = {}) => {
        if (typeof window.gtag === 'function') {
          window.gtag('event', eventName, parameters);
          return;
        }
        window.dataLayer?.push({ event: eventName, ...parameters });
      };

      document.querySelectorAll<HTMLAnchorElement>('a[href^="/contact"]').forEach((link) => {
        link.addEventListener('click', () => {
          track('contact_click', {
            source_path: window.location.pathname,
            cta_label: link.textContent?.trim() ?? '',
          });
        });
      });

      document.querySelectorAll<HTMLElement>('[data-analytics-event]').forEach((element) => {
        element.addEventListener('click', () => {
          const eventName = element.dataset.analyticsEvent;
          if (eventName) {
            track(eventName, {
              source_path: window.location.pathname,
              cta_label: element.textContent?.trim() ?? '',
            });
          }
        });
      });

      const pageViewEvent = document.body.dataset.pageViewEvent;
      if (pageViewEvent) track(pageViewEvent, { page_path: window.location.pathname });
    </script>
  </body>
</html>
