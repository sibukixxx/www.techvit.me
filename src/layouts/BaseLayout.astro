---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ShareBar from '../components/ShareBar.astro';

interface Props {
  title: string;
  description: string;
  lang?: 'ja' | 'en';
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  alternates?: { lang: string; href: string }[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, lang = 'ja', image, imageAlt, type, noindex, alternates, jsonLd } = Astro.props;
const currentPath = Astro.url.pathname;
const japanesePath = currentPath.startsWith('/en/') ? currentPath.slice(3) || '/' : currentPath;
const englishPath = currentPath.startsWith('/en/') ? currentPath : `/en${currentPath}`;
const localizedAlternates =
  alternates ??
  (noindex
    ? []
    : [
        { lang: 'ja', href: japanesePath },
        { lang: 'en', href: englishPath },
        { lang: 'x-default', href: japanesePath },
      ]);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      description={description}
      lang={lang}
      image={image}
      imageAlt={imageAlt}
      type={type}
      noindex={noindex}
      alternates={localizedAlternates}
      jsonLd={jsonLd}
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    {!noindex && <ShareBar title={title} lang={lang} />}
    <Footer />
  </body>
</html>
