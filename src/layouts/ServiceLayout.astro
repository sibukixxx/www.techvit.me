---
import { getEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Tag from '../components/Tag.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import { buildServiceJsonLd, buildFaqJsonLd, buildBreadcrumbJsonLd, absoluteUrl } from '../lib/seo';
import type { CollectionEntry } from 'astro:content';

interface Props {
  service: CollectionEntry<'services'>;
}

const { service } = Astro.props;
const { title, summary, target, problems, deliverables, approach, techStack, priceRange, relatedProjects, relatedExpertise, faq } =
  service.data;

const url = absoluteUrl(`/services/${service.id}/`);

const jsonLd = [
  buildServiceJsonLd({ name: title, description: summary, url, priceRange }),
  buildBreadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services/' },
    { name: title, path: `/services/${service.id}/` },
  ]),
  ...(faq.length > 0 ? [buildFaqJsonLd(faq)] : []),
];

const projectEntries = (await Promise.all(relatedProjects.map((id) => getEntry('projects', id)))).filter(
  (entry): entry is NonNullable<typeof entry> => Boolean(entry),
);
const expertiseEntries = (await Promise.all(relatedExpertise.map((id) => getEntry('expertise', id)))).filter(
  (entry): entry is NonNullable<typeof entry> => Boolean(entry),
);
---

<BaseLayout title={title} description={summary} type="article" jsonLd={jsonLd}>
  <article class="mx-auto max-w-2xl px-6 py-20">
    <a href="/services" class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)]">← Services</a>

    <header class="mt-6">
      <h1 class="text-2xl font-semibold">{title}</h1>
      <p class="mt-3 text-sm leading-relaxed text-[var(--color-fg-muted)]">{summary}</p>
    </header>

    <section class="mt-10">
      <h2 class="text-xs font-medium uppercase tracking-wide text-[var(--color-fg-muted)]">対象</h2>
      <p class="mt-2 text-sm leading-relaxed">{target}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xs font-medium uppercase tracking-wide text-[var(--color-fg-muted)]">こんな課題に対応します</h2>
      <ul class="mt-3 space-y-2 text-sm leading-relaxed text-[var(--color-fg-muted)]">
        {problems.map((item) => <li class="flex gap-2"><span aria-hidden="true">・</span>{item}</li>)}
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="text-xs font-medium uppercase tracking-wide text-[var(--color-fg-muted)]">提供内容</h2>
      <ul class="mt-3 space-y-2 text-sm leading-relaxed text-[var(--color-fg-muted)]">
        {deliverables.map((item) => <li class="flex gap-2"><span aria-hidden="true">・</span>{item}</li>)}
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="text-xs font-medium uppercase tracking-wide text-[var(--color-fg-muted)]">進め方</h2>
      <ol class="mt-3 space-y-2 text-sm leading-relaxed text-[var(--color-fg-muted)]">
        {approach.map((item, index) => <li class="flex gap-2"><span class="font-mono text-[var(--color-accent)]">{index + 1}.</span>{item}</li>)}
      </ol>
    </section>

    <section class="mt-10">
      <h2 class="text-xs font-medium uppercase tracking-wide text-[var(--color-fg-muted)]">技術</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        {techStack.map((item) => <Tag label={item} />)}
      </div>
    </section>

    {
      priceRange && (
        <section class="mt-10">
          <h2 class="text-xs font-medium uppercase tracking-wide text-[var(--color-fg-muted)]">料金目安</h2>
          <p class="mt-2 text-sm leading-relaxed">{priceRange}</p>
        </section>
      )
    }

    <div class="prose mt-10 text-[15px]">
      <slot />
    </div>

    {
      (projectEntries.length > 0 || expertiseEntries.length > 0) && (
        <section class="mt-12">
          <h2 class="text-xs font-medium uppercase tracking-wide text-[var(--color-fg-muted)]">関連する実績・専門性</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {projectEntries.map((entry) => (
              <Card href={`/projects/${entry.id}`} title={entry.data.title} description={entry.data.description} eyebrow="Project" />
            ))}
            {expertiseEntries.map((entry) => (
              <Card href={`/expertise/${entry.id}`} title={entry.data.title} description={entry.data.summary} eyebrow="Expertise" />
            ))}
          </div>
        </section>
      )
    }

    {
      faq.length > 0 && (
        <section class="mt-12">
          <h2 class="text-xs font-medium uppercase tracking-wide text-[var(--color-fg-muted)]">FAQ</h2>
          <div class="mt-4 space-y-4">
            {faq.map((item) => (
              <div class="rounded-lg border border-[var(--color-border)] p-6">
                <p class="text-sm font-semibold">{item.question}</p>
                <p class="mt-2 text-sm leading-relaxed text-[var(--color-fg-muted)]">{item.answer}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <div class="mt-12 text-center">
      <Button href="/contact">この内容で相談する</Button>
    </div>
  </article>
</BaseLayout>
