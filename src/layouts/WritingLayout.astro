---
import { getEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Tag from '../components/Tag.astro';
import Card from '../components/Card.astro';
import { writingCategoryLabels } from '../lib/content';
import { buildArticleJsonLd, buildBreadcrumbJsonLd, absoluteUrl } from '../lib/seo';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'writing'> | CollectionEntry<'writingEn'>;
  lang?: 'ja' | 'en';
}

const { post, lang = 'ja' } = Astro.props;
const isEnglish = lang === 'en';
const basePath = isEnglish ? '/en/writing' : '/writing';
const { title, description, category, tags, pubDate, updatedDate, relatedServices } = post.data;

// Services にはまだ英語版がないため、日本語ページでのみ関連リンクを解決する
const serviceEntries = isEnglish
  ? []
  : (await Promise.all(relatedServices.map((id) => getEntry('services', id)))).filter(
      (entry): entry is NonNullable<typeof entry> => Boolean(entry),
    );

const jsonLd = [
  buildArticleJsonLd({
    title,
    description,
    url: absoluteUrl(`${basePath}/${post.id}`),
    pubDate,
    updatedDate,
  }),
  buildBreadcrumbJsonLd([
    { name: 'Home', path: lang === 'en' ? '/en/' : '/' },
    { name: 'Writing', path: `${basePath}/` },
    { name: title, path: `${basePath}/${post.id}/` },
  ]),
];

const dateFormatter = new Intl.DateTimeFormat(isEnglish ? 'en-US' : 'ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description} lang={lang} type="article" jsonLd={jsonLd}>
  <article class="mx-auto max-w-2xl px-6 py-20">
    <a href={basePath} class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)]">← Writing</a>

    <header class="mt-6">
      <div class="flex flex-wrap items-center gap-2">
        <Tag label={writingCategoryLabels[category]} />
        {tags.map((tag) => <Tag label={tag} />)}
      </div>
      <h1 class="mt-4 text-2xl font-semibold">{title}</h1>
      <p class="mt-3 text-xs text-[var(--color-fg-muted)]">
        <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
      </p>
    </header>

    <div class="prose mt-10 text-[15px]">
      <slot />
    </div>

    {
      serviceEntries.length > 0 && (
        <section class="mt-12">
          <h2 class="text-xs font-medium uppercase tracking-wide text-[var(--color-fg-muted)]">関連するService</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {serviceEntries.map((entry) => (
              <Card href={`/services/${entry.id}`} title={entry.data.title} description={entry.data.summary} eyebrow="Service" />
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
