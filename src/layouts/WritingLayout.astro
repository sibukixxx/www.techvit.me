---
import BaseLayout from './BaseLayout.astro';
import Tag from '../components/Tag.astro';
import { writingCategoryLabels } from '../lib/content';
import { buildArticleJsonLd, buildBreadcrumbJsonLd, absoluteUrl } from '../lib/seo';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'writing'>;
}

const { post } = Astro.props;
const { title, description, category, tags, pubDate, updatedDate } = post.data;

const jsonLd = [
  buildArticleJsonLd({
    title,
    description,
    url: absoluteUrl(`/writing/${post.id}`),
    pubDate,
    updatedDate,
  }),
  buildBreadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Writing', path: '/writing/' },
    { name: title, path: `/writing/${post.id}/` },
  ]),
];

const dateFormatter = new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description} type="article" jsonLd={jsonLd}>
  <article class="mx-auto max-w-2xl px-6 py-20">
    <a href="/writing" class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)]">← Writing</a>

    <header class="mt-6">
      <div class="flex flex-wrap items-center gap-2">
        <Tag label={writingCategoryLabels[category]} />
        {tags.map((tag) => <Tag label={tag} />)}
      </div>
      <h1 class="mt-4 text-2xl font-semibold">{title}</h1>
      <p class="mt-3 text-xs text-[var(--color-fg-muted)]">
        <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
      </p>
    </header>

    <div class="prose mt-10 text-[15px]">
      <slot />
    </div>
  </article>
</BaseLayout>
