# Public — safe to expose client-side, inlined at build time.
PUBLIC_TURNSTILE_SITE_KEY=

# Secret — set only in Cloudflare Pages dashboard (Settings > Environment variables).
# Never commit real values. Used locally only via `wrangler pages dev` with `.dev.vars`.
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
